# Trinity (TDE) applications are installed below /opt/trinity by convention.
tde-flatpak-trinity: dir-or-file-in-opt [opt/trinity/*]
# The TDE/TQt toolchain does not produce a GNU_RELRO segment (same for all
# binaries in the Trinity archive), although -Wl,-z,relro is passed.
tde-flatpak-trinity: hardening-no-relro [opt/trinity/bin/tdeflatpak]
tde-flatpak-trinity: hardening-no-relro [opt/trinity/lib/trinity/kcm_tdeflatpak.so]
